{
  "name": "slipstrike",
  "version": "0.1.0",
  "description": "SLIPSTRIKE - a fast-movement browser arena FPS (Three.js + Node WebSocket server)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "bot": "node scripts/bot.js",
    "e2e": "node e2e/run.mjs",
    "build:practice": "node scripts/build-artifact.mjs --offline",
    "build:claude": "node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "three": "^0.180.0",
    "vite": "^7.3.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
